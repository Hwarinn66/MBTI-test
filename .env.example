# Seluruh analisis dijalankan lokal. Tidak memerlukan API key.
PORT=8000

# Opsional: model bahasa GGUF untuk narasi generatif yang lebih luwes.
# Isi path lokal (relatif terhadap folder proyek atau path absolut).
# Contoh: models/downloads/Qwen3-4B-Q4_K_M.gguf
LOCAL_LLM_PATH=
LOCAL_LLM_THREADS=4
# 0 = CPU; -1 = seluruh lapisan ke GPU jika runtime mendukung.
LOCAL_LLM_GPU_LAYERS=0
